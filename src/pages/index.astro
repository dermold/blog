---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, type CategoryKey } from '../consts';
import { getPosts, url } from '../lib/utils';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const counts = Object.fromEntries(
  (Object.keys(CATEGORIES) as CategoryKey[]).map((key) => [key, posts.filter((p) => p.data.category === key).length]),
) as Record<CategoryKey, number>;
const pad = (n: number) => String(n).padStart(3, '0');

// Pixel-Bild für die Startseite: ein offenes Buch, aus dem ein Pflänzchen wächst.
// Jedes Zeichen ist ein Pixel, die Farben stehen in "colors".
const sprite = [
  '..kkkk....kkkk..',
  '.kggggk..kllllk.',
  'kggggggkkllllllk',
  '.kgggggsslllllk.',
  '..kkkkksskkkkk..',
  '.......ss.......',
  '.......ss.......',
  '.kkkkkkkkkkkkkk.',
  'kwwwwwwkkwwwwwwk',
  'kwpppwwkkwpppwwk',
  'kwwwwwwkkwwwwwwk',
  'kwppppwkkwppwwwk',
  'kwwwwwwkkwwwwwwk',
  'kkkkkkkkkkkkkkkk',
  '.kaaaaaaaaaaaak.',
  '..kkkkkkkkkkkk..',
];
const colors: Record<string, string> = {
  k: '#1a1029',
  g: '#6fd38a',
  l: '#d7ff3c',
  s: '#2f8a4a',
  w: '#f5eddc',
  p: '#8f6cff',
  a: '#5b2bb5',
};
const pixels = sprite.flatMap((row, y) =>
  [...row].flatMap((c, x) => (colors[c] ? [{ x, y, fill: colors[c] }] : [])),
);

const ticker = ['Gedanken', 'Geschichten', 'Erlebnisse', 'Erzählungen', 'Das Leben', 'Ausgedachtes'];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="status">
          <span class="dot" aria-hidden="true"></span>
          {pad(posts.length)} {posts.length === 1 ? 'Beitrag' : 'Beiträge'} · geschrieben von Sebastian
        </p>
        <h1>
          Hallo, ich bin Sebastian.
          <span class="line">
            Hier schreibe ich über <span class="tag-term">das Leben</span> und erzähle{' '}
            <span class="tag-story">Geschichten</span>.
          </span>
        </h1>
        <p class="lead">
          Ein Ort für persönliche Gedanken, kleine und große Erlebnisse und Erzählungen, die ich mit dir teilen möchte.
        </p>
        <div class="hero-actions">
          <a class="button" href={url('blog/')}>Zu den Beiträgen →</a>
          <a class="button ghost" href={url('ueber-mich/')}>Über mich</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-frame box">
          <svg class="sprite" viewBox="0 0 16 16" shape-rendering="crispEdges">
            {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
          </svg>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker">
      <div class="ticker-track">
        {
          [0, 1].map(() => (
            <span>
              {ticker.map((word) => (
                <>
                  {word} <b>/</b>{' '}
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <section class="section worlds-section">
    <div class="container">
      <div class="section-head">
        <h2>Wähle deine Welt</h2>
      </div>
      <div class="worlds">
        <a class="world world-term reveal" href={url('kategorien/persoenliches/')}>
          <span class="sticker world-no">Welt 1</span>
          <span class="win-bar">
            <span class="dots"><i></i><i></i><i></i></span>
            sebastian@blog: ~/{CATEGORIES.persoenliches.folder}
          </span>
          <span class="term-body">
            <span><b>$</b> cd ~/{CATEGORIES.persoenliches.folder}</span>
            <span><b>$</b> cat README</span>
            <span class="out name">{CATEGORIES.persoenliches.name}</span>
            <span class="out"># {CATEGORIES.persoenliches.description}</span>
            <span><b>$</b> ls | wc -l</span>
            <span class="out count">
              {counts.persoenliches} {counts.persoenliches === 1 ? 'Eintrag' : 'Einträge'}
            </span>
            <span><b>$</b> <span class="cursor"></span></span>
          </span>
        </a>

        <a class="world world-portal reveal" href={url('kategorien/geschichten/')} data-portal>
          <span class="sticker world-no">Welt 2</span>
          <span class="win-bar">
            <span class="dots"><i></i><i></i><i></i></span>
            portal: ~/{CATEGORIES.geschichten.folder}
          </span>
          <span class="portal-body">
            <span class="portal-text">
              <span class="once">Es war einmal …</span>
              <span class="portal-title">{CATEGORIES.geschichten.name}</span>
              <span class="portal-desc">{CATEGORIES.geschichten.description}</span>
              <span class="portal-count">
                {counts.geschichten} {counts.geschichten === 1 ? 'Erzählung' : 'Erzählungen'}
              </span>
              <span class="portal-enter">Eintreten →</span>
            </span>
            <span class="portal-gate" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
              <b></b>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Neueste Beiträge</h2>
        <a href={url('blog/')}>alle ansehen →</a>
      </div>
      {
        latest.length > 0 ? (
          <ul class="post-grid">
            {latest.map((post) => (
              <li class="reveal">
                <PostCard post={post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Noch keine Beiträge. Der erste kommt bald!</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Welt 2: Beim Klick wird man ins Portal hineingezogen, danach öffnet sich die Seite.
  const link = document.querySelector<HTMLAnchorElement>('[data-portal]');
  const gate = link?.querySelector<HTMLElement>('.portal-gate');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  link?.addEventListener('click', (event) => {
    if (calm || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const rect = (gate ?? link).getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const root = document.documentElement;
    root.style.setProperty('--portal-x', `${x}px`);
    root.style.setProperty('--portal-y', `${y}px`);
    root.style.setProperty('--portal-page-y', `${y + window.scrollY}px`);
    const overlay = document.createElement('div');
    overlay.className = 'portal-overlay';
    document.body.append(overlay);
    root.classList.add('portal-active');
    try {
      sessionStorage.setItem('portal', '1');
    } catch {}
    setTimeout(() => {
      location.href = link.href;
    }, 900);
  });

  // Beim Zurückblättern (Browser-Cache) den Ausgangszustand wiederherstellen.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    document.documentElement.classList.remove('portal-active');
    document.querySelectorAll('.portal-overlay').forEach((el) => el.remove());
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #3fbf6a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #3fbf6a 25%, transparent);
  }
  h1 {
    font-size: clamp(2.3rem, 6vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  h1 .line {
    display: block;
    margin-top: 0.15em;
    color: var(--text-muted);
    font-weight: 500;
  }
  /* "das Leben" als Terminal-Schnipsel, "Geschichten" im Portal-Lila */
  .tag-term,
  .tag-story {
    display: inline-block;
    padding: 0 0.25em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    line-height: 1.15;
  }
  .tag-term {
    background: var(--term-bg);
    color: var(--term-prompt);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85em;
    letter-spacing: -0.04em;
  }
  .tag-term::before {
    content: '>';
    color: var(--term-dim);
    margin-right: 0.15em;
  }
  .tag-story {
    background: radial-gradient(circle at 70% 40%, #4b2a95, var(--term-bg) 80%);
    color: #fff;
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 400;
    font-size: 0.9em;
    letter-spacing: -0.01em;
  }
  .lead {
    max-width: 34rem;
    font-size: 1.2rem;
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-art {
    justify-self: center;
    width: min(100%, 21rem);
  }
  .art-frame {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background-color: var(--accent);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-size: 1.375rem 1.375rem;
    box-shadow: var(--hard-lg);
  }
  .sprite {
    width: 70%;
    image-rendering: pixelated;
    filter: drop-shadow(6px 6px 0 rgb(0 0 0 / 0.3));
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      width: min(60%, 14rem);
      order: -1;
    }
  }

  /* ---------- Laufband ---------- */
  .ticker-wrap {
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .ticker {
    overflow: hidden;
    border-block: 2px solid var(--ink);
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    padding-block: 0.6rem;
    animation: marquee 60s linear infinite;
  }
  .ticker-track > span {
    padding-right: 1rem;
  }
  .ticker b {
    color: var(--pop);
    margin-inline: 0.75rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Welten ---------- */
  .worlds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2.25rem;
  }
  .world {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--hard);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.6s ease;
  }
  .world:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--hard-lg);
  }
  .world-no {
    position: absolute;
    top: -0.9rem;
    right: 1rem;
    z-index: 1;
    transform: none;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--term-bar);
    border-bottom: 2px solid var(--ink);
    border-radius: var(--radius) var(--radius) 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--term-dim);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid #000;
    border-radius: 50%;
    background: #ff6b8b;
  }
  .dots i:nth-child(2) {
    background: var(--pop);
  }
  .dots i:nth-child(3) {
    background: #8f6cff;
  }

  .world-term {
    background: var(--term-bg);
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }
  .term-body {
    display: grid;
    gap: 0.3rem;
    padding: 1.25rem 1.3rem 1.5rem;
  }
  .term-body b {
    color: var(--term-prompt);
  }
  .term-body .out {
    color: var(--term-dim);
    padding-left: 1.1rem;
  }
  .term-body .name {
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .term-body .count {
    color: var(--term-prompt);
  }
  .world-term:hover .name {
    color: var(--term-prompt);
  }

  /* Welt 2: ein Portal in die Geschichten */
  .world-portal {
    color: #e9e0ff;
    background-color: var(--term-bg);
    background-image:
      radial-gradient(circle at 80% 60%, rgb(143 108 255 / 0.45), transparent 45%),
      radial-gradient(rgb(255 255 255 / 0.45) 1px, transparent 1.5px),
      radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.5px);
    background-size: auto, 46px 46px, 29px 29px;
    background-position: 0 0, 7px 11px, 19px 3px;
  }
  .portal-body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    flex: 1;
    padding: 1.25rem 1.3rem 1.5rem;
  }
  .portal-text {
    display: grid;
    gap: 0.35rem;
  }
  .once {
    font-family: var(--font-read);
    font-style: italic;
    color: var(--term-dim);
  }
  .portal-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #fff;
  }
  .portal-desc {
    font-family: var(--font-read);
    line-height: 1.55;
    color: #cfc3ea;
  }
  .portal-count {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--term-prompt);
  }
  .portal-enter {
    justify-self: start;
    margin-top: 0.6rem;
    padding: 0.3rem 0.7rem;
    border: 2px solid #e9e0ff;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .world-portal:hover .portal-enter {
    background: var(--pop);
    border-color: var(--pop);
    color: var(--pop-text);
  }
  .world-portal:hover .portal-title {
    color: var(--term-prompt);
  }

  /* Das Tor: ineinanderliegende Rahmen, die sich langsam drehen */
  .portal-gate {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 20vw, 9rem);
    aspect-ratio: 1;
  }
  .portal-gate i {
    position: absolute;
    border: 2px solid rgb(199 178 255 / 0.7);
    border-radius: 30%;
    animation: spin 28s linear infinite;
    transition: border-color 0.3s ease;
  }
  .portal-gate i:nth-child(1) {
    inset: 0;
  }
  .portal-gate i:nth-child(2) {
    inset: 14%;
    animation-direction: reverse;
    animation-duration: 20s;
  }
  .portal-gate i:nth-child(3) {
    inset: 28%;
    animation-duration: 14s;
  }
  .portal-gate i:nth-child(4) {
    inset: 40%;
    animation-direction: reverse;
    animation-duration: 9s;
  }
  .portal-gate b {
    width: 14%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 18px 6px rgb(143 108 255 / 0.9);
  }
  .world-portal:hover .portal-gate i {
    border-color: var(--pop);
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @media (max-width: 26rem) {
    .portal-body {
      grid-template-columns: 1fr;
    }
    .portal-gate {
      position: absolute;
      right: 1rem;
      top: 1rem;
      width: 4.5rem;
      opacity: 0.6;
    }
  }
</style>
