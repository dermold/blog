---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';
import { getPosts, url, type Post } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (Object.keys(CATEGORIES) as CategoryKey[]).map((key) => ({
    params: { category: key },
    props: { key, posts: posts.filter((p) => p.data.category === key) },
  }));
}

interface Props {
  key: CategoryKey;
  posts: Post[];
}

const { key, posts } = Astro.props;
const category = CATEGORIES[key];
const entries = Object.entries(CATEGORIES) as [CategoryKey, (typeof CATEGORIES)[CategoryKey]][];
---

<BaseLayout title={category.name} description={category.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Kategorie</span>
      <h1><span aria-hidden="true">{category.emoji}</span> {category.name}</h1>
      <p>{category.description}</p>
      {
        category.look === 'terminal' ? (
          <p class="flavor flavor-term" aria-hidden="true">
            <b>$</b> ls ~/{category.folder} <span class="cursor" />
          </p>
        ) : (
          <p class="flavor flavor-portal">
            Es war einmal … <a href={url('geschichten/')}>zur Welt der Geschichten →</a>
          </p>
        )
      }
    </header>

    <nav aria-label="Nach Kategorie filtern" class="filter">
      <ul class="chip-list">
        <li><a class="chip" href={url('blog/')}>Alle</a></li>
        {
          entries.map(([k, cat]) => (
            <li>
              <a
                class:list={['chip', { 'is-active': k === key }]}
                href={url(`kategorien/${k}/`)}
                aria-current={k === key ? 'page' : undefined}
              >
                <span aria-hidden="true">{cat.emoji}</span> {cat.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      posts.length > 0 ? (
        <ul class="post-grid">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">In dieser Kategorie gibt es noch keine Beiträge.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .filter {
    margin-bottom: 2rem;
  }
  .page-head .flavor {
    margin-top: 1rem;
  }
  .flavor-term {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 2px solid var(--ink);
    background: var(--term-bg);
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .flavor-term b {
    color: var(--term-prompt);
  }
  .flavor-portal {
    font-family: var(--font-read);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
  }
</style>
