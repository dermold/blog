---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';
import { getPosts, url } from '../../lib/utils';

const posts = await getPosts();
const entries = Object.entries(CATEGORIES) as [CategoryKey, (typeof CATEGORIES)[CategoryKey]][];
---

<BaseLayout title="Kategorien" description="Alle Kategorien des Blogs.">
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Kategorien</span>
      <h1>Worüber ich schreibe</h1>
    </header>
    <ul class="list">
      {
        entries.map(([key, cat]) => {
          const count = posts.filter((p) => p.data.category === key).length;
          return (
            <li class="reveal">
              <a class={`look-${cat.look}`} href={url(`kategorien/${key}/`)}>
                <span class="emoji" aria-hidden="true">{cat.emoji}</span>
                <span>
                  <strong>{cat.name}</strong>
                  <span class="desc">{cat.description}</span>
                </span>
                <span class="count">{count}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--hard);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  a:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--hard-lg);
  }
  .look-terminal {
    background: var(--term-bg);
    color: var(--term-text);
    font-family: var(--font-mono);
  }
  .look-terminal strong {
    font-family: var(--font-ui);
    color: #fff;
  }
  .look-terminal strong::before {
    content: '~/';
    color: var(--term-prompt);
  }
  .look-terminal .desc {
    color: var(--term-dim);
  }
  .look-portal {
    color: #e9e0ff;
    background-color: var(--term-bg);
    background-image:
      radial-gradient(circle at 100% 50%, rgb(143 108 255 / 0.4), transparent 50%),
      radial-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1.5px);
    background-size: auto, 38px 38px;
  }
  .look-portal strong {
    font-family: var(--font-read);
    font-weight: 600;
    color: #fff;
  }
  .look-portal .desc {
    font-family: var(--font-read);
    font-style: italic;
    color: #cfc3ea;
  }
  .emoji {
    font-size: 2.25rem;
  }
  strong {
    display: block;
    font-size: 1.5rem;
  }
  .count {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: 0.5rem;
    border: 2px solid #1a1029;
    background: var(--pop);
    color: var(--pop-text);
    font-family: var(--font-mono);
    font-weight: 700;
    box-shadow: 2px 2px 0 #1a1029;
  }
</style>
