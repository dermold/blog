---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectTags, getPosts, slugify, url, type Post } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === tag.slug)) },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`Beiträge zum Thema ${name}.`}>
  <div class="container">
    <header class="page-head">
      <a class="back" href={url('tags/')}>← Alle Tags</a>
      <h1>#{name}</h1>
      <p>{posts.length} {posts.length === 1 ? 'Beitrag' : 'Beiträge'} mit diesem Schlagwort.</p>
    </header>
    <ul class="post-grid">
      {
        posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .back {
    display: block;
    width: fit-content;
    margin-bottom: 1rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
