---
import { SITE_TITLE, AUTHOR } from '../consts';
import { url } from '../lib/utils';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>
      <span class="eof" aria-hidden="true">[EOF]</span>
      © {year} {AUTHOR} · {SITE_TITLE}
    </p>
    <ul>
      <li><a href={url('blog/')}>Alle Beiträge</a></li>
      <li><a href={url('ueber-mich/')}>Über mich</a></li>
      <li><a href={url('rss.xml')}>RSS-Feed</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 2px solid var(--ink);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
  }
  p {
    margin: 0;
  }
  .eof {
    margin-right: 0.5rem;
    padding: 0.1rem 0.4rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-pixel);
    font-size: 0.75rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 700;
  }
  a::before {
    content: './';
    color: var(--accent);
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
