---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../lib/utils';

const links = [
  { href: url(''), label: 'Start' },
  { href: url('blog/'), label: 'Blog' },
  { href: url('geschichten/'), label: 'Geschichten' },
  { href: url('kategorien/'), label: 'Kategorien' },
  { href: url('tags/'), label: 'Tags' },
  { href: url('ueber-mich/'), label: 'Über mich' },
];

// Markiert den aktuellen Menüpunkt.
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => {
  const target = href.replace(/\/?$/, '/');
  return target === url('').replace(/\/?$/, '/') ? path === target : path.startsWith(target);
};
---

<header class="site-header">
  <div class="container inner">
    <a class="logo" href={url('')}>
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" rx="4" class="mark-bg"></rect>
        <path d="M21 9.5h-7.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H10" class="mark-s"></path>
        <rect x="23" y="21" width="4.5" height="3.5" class="mark-cursor"></rect>
      </svg>
      <span class="logo-text">sebastian<span class="logo-suffix">/blog</span></span>
      <span class="visually-hidden">{SITE_TITLE}</span>
    </a>

    <div class="actions">
      <a class="icon-button" href={url('suche/')} aria-label="Suche" title="Suche">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <ThemeToggle />
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="hauptmenue" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav id="hauptmenue" class="nav" aria-label="Hauptmenü">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.getElementById('hauptmenue');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    nav?.classList.toggle('is-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Dunkles Rauchglas wie die Terminal- und Portal-Karten, in Hell und Dunkel gleich.
       Die Farbwerte gelten für alles in der Kopfzeile (Logo, Menü, Knöpfe). */
    --text: #ede6fa;
    --text-muted: #b9add3;
    --surface: rgb(255 255 255 / 0.08);
    --ink: rgb(199 178 255 / 0.55);
    --accent: #7c4dd8;
    --accent-contrast: #ffffff;
    --glass-hi: rgb(255 255 255 / 0.14);
    color: var(--text);
    background:
      radial-gradient(30rem 6rem at 85% 0%, rgb(143 108 255 / 0.3), transparent 70%),
      rgb(16 9 28 / 0.94);
    border-bottom: 2px solid #0b0613;
    box-shadow:
      inset 0 -1px 0 var(--glass-hi),
      0 6px 24px rgb(20 11 34 / 0.25);
  }
  .logo-suffix {
    color: #c7b2ff;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    margin-right: auto;
  }
  .logo-mark {
    width: 2.3rem;
    height: 2.3rem;
    filter: drop-shadow(3px 3px 0 var(--ink));
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .logo:hover .logo-mark {
    transform: translate(-1px, -1px);
    filter: drop-shadow(4px 4px 0 var(--ink));
  }
  .mark-bg {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .mark-s {
    fill: none;
    stroke: #fff;
    stroke-width: 3.2;
    stroke-linecap: square;
  }
  .mark-cursor {
    fill: var(--pop);
  }
  .logo:hover .mark-cursor {
    animation: blink 1s steps(2) infinite;
  }
  .logo-suffix {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.9em;
  }
  .nav ul {
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: block;
    padding: 0.4rem 0.75rem;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.12s ease, color 0.12s ease, transform 0.12s ease;
  }
  .nav a:hover {
    color: var(--text);
    border-color: var(--ink);
    background: var(--surface);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .nav a[aria-current='page'] {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    order: 2;
  }
  .icon-button {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
  }
  .icon-button:hover {
    color: var(--pop-text);
    background: var(--pop);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .icon-button svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: square;
  }
  .menu-button {
    display: none;
  }

  /* Smartphone: Menü hinter einem Knopf */
  @media (max-width: 59.99rem) {
    .inner {
      flex-wrap: wrap;
    }
    .menu-button {
      display: grid;
      gap: 4px;
      place-content: center;
      width: 2.6rem;
      height: 2.6rem;
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      background: var(--surface);
      box-shadow: 2px 2px 0 var(--ink);
      cursor: pointer;
    }
    .menu-button span {
      display: block;
      width: 1.1rem;
      height: 2px;
      background: var(--text);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu-button[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-button[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }
    .menu-button[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .nav {
      display: none;
      order: 3;
      width: 100%;
      padding-bottom: 1rem;
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav a {
      padding: 0.7rem 1rem;
    }
    .nav a::before {
      content: '> ';
      color: var(--accent);
    }
    .nav a[aria-current='page']::before {
      color: inherit;
    }
    .logo-text {
      font-size: 1rem;
    }
  }

  @media (min-width: 60rem) {
    .nav {
      order: 1;
    }
  }
</style>
