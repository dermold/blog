---
import { CATEGORIES } from '../consts';
import { formatDate, readingTime, url, type Post } from '../lib/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category = CATEGORIES[post.data.category];
const categoryUrl = url(`kategorien/${post.data.category}/`);
const postUrl = url(`blog/${post.id}/`);
const minutes = readingTime(post.body);
const isoDate = post.data.date.toISOString().slice(0, 10);
---

{
  category.look === 'terminal' ? (
    <article class="card terminal">
      <div class="bar">
        <span class="dots" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <span class="path">
          ~/<a href={categoryUrl}>{category.folder}</a>/{post.id}.md
        </span>
      </div>
      <div class="body">
        <p class="cmd" aria-hidden="true">
          <span class="prompt">$</span> cat {post.id}.md
        </p>
        <h3>
          <a href={postUrl}>{post.data.title}</a>
        </h3>
        <p class="description">{post.data.description}</p>
        <p class="log">
          <time datetime={post.data.date.toISOString()}>[{isoDate}]</time> {minutes} min lesen
          <span class="cursor" aria-hidden="true" />
        </p>
      </div>
    </article>
  ) : (
    <article class="card portal">
      <a class="label" href={categoryUrl}>
        ✦ {category.name}
      </a>
      <h3>
        <a href={postUrl}>{post.data.title}</a>
      </h3>
      <p class="description">{post.data.description}</p>
      <p class="foot">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{minutes} Min.</span>
      </p>
    </article>
  )
}

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--hard);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--hard-lg);
  }
  h3 {
    margin: 0;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* Die ganze Karte ist anklickbar */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .description {
    margin: 0;
    flex: 1;
  }

  /* ---------- Terminal (Persönliches) ---------- */
  .terminal {
    overflow: hidden;
    background: var(--term-bg);
    color: var(--term-text);
    font-family: var(--font-mono);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: var(--term-bar);
    border-bottom: 2px solid var(--ink);
    font-size: 0.78rem;
    color: var(--term-dim);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border: 1.5px solid #000;
    border-radius: 50%;
    background: #ff6b8b;
  }
  .dots i:nth-child(2) {
    background: var(--pop);
  }
  .dots i:nth-child(3) {
    background: #8f6cff;
  }
  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .path a {
    position: relative;
    z-index: 2;
    color: var(--term-text);
  }
  .path a:hover {
    color: var(--term-prompt);
  }
  .terminal .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .cmd {
    margin: 0;
    font-size: 0.82rem;
    color: var(--term-dim);
  }
  .prompt {
    color: var(--term-prompt);
    font-weight: 700;
  }
  .terminal h3 {
    font-family: var(--font-ui);
    font-size: 1.35rem;
    color: #fff;
  }
  .terminal:hover h3 {
    color: var(--term-prompt);
  }
  .terminal .description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--term-text);
    opacity: 0.85;
  }
  .log {
    margin: 0;
    font-size: 0.8rem;
    color: var(--term-dim);
  }
  .log time {
    color: var(--term-prompt);
  }
  .log .cursor {
    color: var(--term-text);
  }

  /* ---------- Portal (Geschichten) ---------- */
  .portal {
    gap: 0.75rem;
    padding: 1.3rem 1.3rem 1.2rem;
    color: #e9e0ff;
    background-color: var(--term-bg);
    background-image:
      radial-gradient(circle at 100% 0%, rgb(143 108 255 / 0.4), transparent 55%),
      radial-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1.5px);
    background-size: auto, 38px 38px;
    background-position: 0 0, 5px 9px;
  }
  .label {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: #c7b2ff;
  }
  .label:hover {
    color: var(--term-prompt);
  }
  .portal h3 {
    font-family: var(--font-read);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.25;
    letter-spacing: 0;
    color: #fff;
  }
  .portal:hover h3 {
    color: var(--term-prompt);
  }
  .portal .description {
    font-family: var(--font-read);
    font-style: italic;
    line-height: 1.65;
    color: #cfc3ea;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--term-dim);
  }
</style>
